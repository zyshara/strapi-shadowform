{
  "kind": "collectionType",
  "collectionName": "dome_of_doom_releases",
  "info": {
    "singularName": "dome-of-doom-release",
    "pluralName": "dome-of-doom-releases",
    "displayName": "Dome of Doom Release"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Single",
        "EP",
        "Album",
        "Remix",
        "Compilation",
        "Sample Pack"
      ]
    },
    "spotify_url": {
      "type": "string"
    },
    "bandcamp_url": {
      "type": "string"
    },
    "bandcamp_artwork_url": {
      "type": "string"
    },
    "artists": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::dome-of-doom-artist.dome-of-doom-artist",
      "mappedBy": "releases"
    },
    "release_date": {
      "type": "date"
    },
    "hide_on_discography_page": {
      "type": "boolean",
      "default": false
    }
  }
}
