{
  "kind": "collectionType",
  "collectionName": "dome_of_doom_artists",
  "info": {
    "singularName": "dome-of-doom-artist",
    "pluralName": "dome-of-doom-artists",
    "displayName": "Dome of Doom Artist"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "releases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::dome-of-doom-release.dome-of-doom-release",
      "inversedBy": "artists"
    },
    "shows": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::dome-of-doom-show.dome-of-doom-show",
      "inversedBy": "artists"
    },
    "bandcamp_url": {
      "type": "string"
    },
    "spotify_url": {
      "type": "string"
    },
    "bandcamp_profile_picture": {
      "type": "string"
    },
    "profile_picture_override": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "bandcamp_biography": {
      "type": "blocks"
    },
    "spotify_biography": {
      "type": "blocks"
    },
    "biography_override": {
      "type": "blocks"
    }
  }
}
